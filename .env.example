OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api
AHEAPI_API_BASE_URL=
AHEAPI_API_KEY=
UNIAPI_API_BASE_URL=
UNIAPI_API_KEY=
AICARDS_BASE_URL=https://aicards.shop
AICARDS_API_BASE_URL=
AICARDS_API_KEY=
AICARDS_USERNAME=
AICARDS_PASSWORD=
# AICards / New API 备用通道批量发布保护。默认必须有真实成本；只有管理员显式开启时才使用保守估算成本。
FLOWAPI_AICARDS_ALLOW_ESTIMATED_COST=false
FLOWAPI_AICARDS_ESTIMATED_COST_MULTIPLIER=1.6
FLOWAPI_AICARDS_AUTO_MIN_PROFIT_MARGIN=0.45
FLOWAPI_AICARDS_AUTO_SELL_MULTIPLIER=2.2
FLOWAPI_AICARDS_SYNC_MAX_COUNT=80
FLOWAPI_AICARDS_INCLUDE_IMAGES=false
OPENAI_API_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OFFICIAL_OPENAI_API_BASE_URL=
OFFICIAL_OPENAI_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
GEMINI_OPENAI_API_BASE_URL=
GEMINI_API_KEY=
ALIYUN_BAILIAN_API_BASE_URL=
ALIYUN_BAILIAN_API_KEY=

# Production database and local service routing.
# Use one of DATABASE_URL / POSTGRES_URL in production so balances, orders, API Keys, calls, and logs are durable.
DATABASE_URL=
POSTGRES_URL=
DATABASE_SSL=true
INTERNAL_FLOWAPI_BASE_URL=http://127.0.0.1:3000
FLOWAPI_INTERNAL_PORT=3000

# FlowAPI admin/session secrets. Do not reuse these example values.
FLOWAPI_ADMIN_SECRET=
ADMIN_SECRET=
SESSION_SECRET=
NEXTAUTH_SECRET=
VERIFY_SECRET=
TOKEN_POOL_ENCRYPTION_KEY=
ADMIN_CONFIG_ENCRYPTION_KEY=
PROXY_ACCESS_TOKEN=
# 新生产库默认不播种测试管理员和默认 Key；只有内部初始化时才显式打开。
FLOWAPI_SEED_ADMIN_IN_PRODUCTION=false
FLOWAPI_SEED_ADMIN_API_KEY=false

# Email delivery for registration verification codes and system mail.
# Registration codes use Resend first, then SMTP as a fallback.
# Do not commit real secrets. Configure at least one provider in production.
RESEND_API_KEY=
EMAIL_FROM=FlowAPI <hello@flowapi.fun>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FlowAPI <hello@flowapi.fun>
ADMIN_ALERT_EMAIL=
FLOWAPI_CRON_SECRET=

# New API adapter layer.
NEW_API_BASE_URL=
NEW_API_KEY=
NEW_API_ADMIN_TOKEN=
NEW_API_DEFAULT_GROUP=default
# 默认由 FlowAPI 生成本地客户 Key，再用服务端分组 Key 转发；只有确实需要 New API 中也生成一份用户 Token 时才改为 true。
FLOWAPI_SYNC_NEW_API_TOKEN_ON_CREATE=false
# 默认不把 New API 管理后台代理到公网；如需开启，必须先在 Cloudflare/Nginx 做管理员访问控制。
FLOWAPI_ENABLE_NEWAPI_ADMIN_PROXY=false
NEW_API_KEY_ALL_MODELS=
NEW_API_OFFICIAL_GROUP=
NEW_API_BRIDGE_GROUP=
NEW_API_CODEX_EXECUTION_GROUP=
NEW_API_CLAUDE_EXECUTION_GROUP=
NEW_API_GPT_PREMIUM_EXECUTION_GROUP=
NEW_API_GEMINI_EXECUTION_GROUP=
NEW_API_DEEPSEEK_EXECUTION_GROUP=

# Commercial guardrails.
FLOWAPI_MIN_TEXT_PROFIT_MARGIN=0.2
# 生产默认必须配置成本价和售价；只有内部测试才可临时放开未配置成本的模型。
FLOWAPI_ALLOW_UNCOSTED_MODELS=false
# 团队缓存命中也必须扣费写账；默认关闭直返缓存，避免缓存绕过 FlowAPI 账本。
FLOWAPI_ENABLE_BILLABLE_TEAM_CACHE=false
FLOWAPI_ENABLE_RESPONSE_CACHE=false
UPSTREAM_REQUEST_TIMEOUT_MS=60000
FLOWAPI_ALLOWED_UPSTREAM_HOSTS=openrouter.ai,api.openai.com,api.anthropic.com,api.deepseek.com,generativelanguage.googleapis.com,dashscope.aliyuncs.com,pincc.flowapi.fun,api.flowapi.fun,aicards.shop
FLOWAPI_REQUIRE_UPSTREAM_HOST_ALLOWLIST=true
FLOWAPI_ALLOW_PRIVATE_UPSTREAMS=false
